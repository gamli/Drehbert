# Copy to 02.dev.env and fill in the empty values.
# Values are Docker env-file values: enter them without shell quotes.
DREHBERT_HOSTNAME=drehbert-dev # you will see drehbert in DEV as this hostname, e.g. drehbert-dev.local
DREHBERT_DEV_WIFI_SSID= # The WIFI's SSID
DREHBERT_DEV_WIFI_PASSWORD= # The WIFI's password
DREHBERT_DEV_WIFI_COUNTRY= # The country where the WIFI is located (controls radio strength and frequencies and stuff)
DREHBERT_DEV_WIFI_HIDDEN=no # Only set to yes if your WIFI's SSID is hidden by the access point
