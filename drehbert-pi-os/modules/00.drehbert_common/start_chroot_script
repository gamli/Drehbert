#!/usr/bin/env bash
set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install --yes --no-install-recommends \
  bluez \
  pi-bluetooth \
  python3 \
  python3-venv

for unit in bluetooth.service hciuart.service; do
  if systemctl list-unit-files "${unit}" --no-legend 2>/dev/null |
     awk -v unit="${unit}" '$1 == unit { found=1 } END { exit !found }'; then
    systemctl enable "${unit}"
  fi
done
