#!/usr/bin/env bash
set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install --yes --no-install-recommends \
  python3 \
  python3-venv

source /common.sh
unpack /filesystem/root /

boot_config=/boot/firmware/config.txt
{
  printf '\n[all]\n'
  printf '# Drehbert USB HID camera remote.\n'
  printf 'dtoverlay=dwc2,dr_mode=peripheral\n'
  printf 'dtoverlay=disable-bt\n'
} >> "${boot_config}"

systemctl disable bluetooth.service hciuart.service >/dev/null 2>&1 || true
systemctl enable drehbert-usb-hid-gadget.service
