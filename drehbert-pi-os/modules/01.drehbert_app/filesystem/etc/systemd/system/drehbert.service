[Unit]
Description=Drehbert
Wants=bluetooth.service
After=bluetooth.service
ConditionPathExists=/opt/drehbert/run

[Service]
Type=simple
User=drehbert
Group=drehbert
SupplementaryGroups=gpio bluetooth
WorkingDirectory=/opt/drehbert
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/drehbert/run
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=drehbert
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
